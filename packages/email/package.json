{
  "name": "@tech-companies-portugal/email",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "lint": "biome check . --write",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit",
    "email:dev": "email dev --port 3002 --dir src/templates"
  },
  "dependencies": {
    "@plunk/node": "3.0.3",
    "@react-email/components": "0.5.7",
    "@react-email/render": "1.4.0",
    "@tech-companies-portugal/core": "workspace:*"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@tech-companies-portugal/typescript": "workspace:*",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "5.2.10",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
